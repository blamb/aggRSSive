# Copy to .env and edit. Every setting is optional except SECRET_KEY in production.

# Long random string. Signs login cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Public URL of this install, no trailing slash. Used in embeds, feeds and OAuth callbacks.
BASE_URL=http://localhost:8000

# Where the SQLite database lives. In Docker this is /data/aggrssive.db.
DATABASE_URL=sqlite:///./data/aggrssive.db

# How often to poll feeds, in minutes.
POLL_INTERVAL_MINUTES=30

# Set to false once you and your colleagues have accounts, to stop strangers signing up.
ALLOW_SIGNUP=true

# Optional: GenAI tag suggestions (an 'ask aggRSSive (GenAI)' button on each source), powered by Claude.
# Costs a fraction of a cent per click with the default model. Leave empty to hide the feature.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Hosting quirk: if this app and your LMS live on the same Jelastic/Reclaim cloud, the LMS hostname
# resolves to a private address that has no HTTPS, and the public IP is unreachable from inside.
# Point it at the private address over plain HTTP instead: host=http://10.x.x.x  (or host=ip to just pin DNS)
DNS_OVERRIDES=

# Optional: sign in with GitHub. Create an OAuth app at https://github.com/settings/developers
# with callback URL  {BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: sign in with Google. Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# with redirect URI  {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Host port for docker compose (the app inside always listens on 8000).
HOST_PORT=8000
